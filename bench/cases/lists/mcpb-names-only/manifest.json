{
  "manifest_version": "0.3",
  "name": "bench-names-only",
  "version": "1.0.0",
  "description": "A bundle that lists its tools by name only.",
  "author": { "name": "Benchmark" },
  "server": { "type": "node", "entry_point": "server/index.js", "mcp_config": { "command": "node", "args": ["${__dirname}/server/index.js"] } },
  "tools": [
    { "name": "list_notes", "description": "Lists notes." },
    { "name": "read_note", "description": "Reads one note." }
  ]
}
